<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.scijava</groupId>
		<artifactId>pom-scijava</artifactId>
		<version>45.1.0</version>
		<relativePath />
	</parent>
	<groupId>ch.unige.biochem</groupId>
	<artifactId>fiji-modules</artifactId>
	<version>0.1.1-SNAPSHOT</version>
	<name>Fiji Modules</name>
	<description>Search, describe and run any SciJava module (command or script) from an agent, headless or live.</description>
	<url>https://github.com/unige-biochem/fiji-modules</url>
	<inceptionYear>2026</inceptionYear>
	<organization><name>UNIGE</name><url>https://www.unige.ch</url></organization>
	<licenses><license><name>MIT</name><distribution>repo</distribution></license></licenses>
	<developers><developer><id>nicokiaru</id><name>Nicolas Chiaruttini</name><roles><role>lead</role></roles></developer></developers>
	<contributors><contributor><name>None</name></contributor></contributors>
	<mailingLists><mailingList><name>Image.sc Forum</name><archive>https://forum.image.sc/tag/fiji</archive></mailingList></mailingLists>
	<scm><connection>scm:git:https://github.com/unige-biochem/fiji-modules</connection><developerConnection>scm:git:git@github.com:unige-biochem/fiji-modules</developerConnection><tag>HEAD</tag><url>https://github.com/unige-biochem/fiji-modules</url></scm>
	<issueManagement><system>GitHub Issues</system><url>https://github.com/unige-biochem/fiji-modules/issues</url></issueManagement>
	<ciManagement><system>None</system></ciManagement>
	<properties>
		<package-name>sc.fiji.llm.module</package-name>
		<license.licenseName>mit</license.licenseName>
		<license.copyrightOwners>UNIGE</license.copyrightOwners>
		<releaseProfiles>sign,deploy-to-scijava</releaseProfiles>
		<license.skip>true</license.skip>
		<!-- fiji-llm and its dependencies (langchain4j, jackson 3, mcp-core...) are compiled for Java 17;
		     the enforcer bytecode rule bans them unless this build targets 17 as well. -->
		<scijava.jvm.version>17</scijava.jvm.version>
	</properties>
	<repositories>
		<repository><id>scijava.public</id><url>https://maven.scijava.org/content/groups/public</url></repository>
	</repositories>
	<dependencies>
		<dependency><groupId>org.scijava</groupId><artifactId>scijava-common</artifactId></dependency>
		<dependency><groupId>com.google.code.gson</groupId><artifactId>gson</artifactId></dependency>
		<dependency><groupId>ch.unige.biochem</groupId><artifactId>scijava-introspect</artifactId><version>0.2.0</version></dependency>
		<dependency><groupId>sc.fiji</groupId><artifactId>fiji-llm</artifactId><version>0.1.0</version><scope>provided</scope></dependency>
	</dependencies>
</project>
